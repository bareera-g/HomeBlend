# Supabase — get these from https://supabase.com/dashboard → Project Settings → API
# VITE_ prefix is required for Vite to expose variables to the browser
VITE_SUPABASE_URL=supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# API base URL
VITE_API_URL=http://localhost:3000

# Mapbox — get your public token from https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=mapbox_public_token
