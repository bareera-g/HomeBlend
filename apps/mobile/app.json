{
  "expo": {
    "name": "HomeBlend",
    "slug": "homeblend-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0f172a",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.homeblend.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.homeblend.mobile"
    },
    "extra": {
      "apiUrl": "http://localhost:3001"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
