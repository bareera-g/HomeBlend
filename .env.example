# Copy this file to .env.local and fill in your values
# Restart dev server after changes.

# Firebase Firestore — No env vars needed. Project config is in firebase-config.js.
# Ensure Firestore is enabled in Firebase Console → Build → Firestore Database.

# Mapbox — https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Anthropic — https://console.anthropic.com/settings/keys (for AI Blend insights)
VITE_ANTHROPIC_API_KEY=your_anthropic_key_here
